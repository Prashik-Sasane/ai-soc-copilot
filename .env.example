# Environment: development, test, production
ENVIRONMENT=development
PROJECT_NAME="AI SOC Copilot"
API_V1_STR="/api/v1"

# Security & Authentication
SECRET_KEY=dev_secret_key_change_in_production_min_32_bytes_long_key_soc
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Settings
# For Docker Compose: postgresql://postgres:postgres@db:5432/ai_soc_db
# For Local Dev: postgresql://postgres:postgres@localhost:5432/ai_soc_db or sqlite:///./ai_soc_dev.db
DATABASE_URL=sqlite:///./ai_soc_dev.db
TEST_DATABASE_URL=sqlite:///./test_ai_soc.db

# AI & LLM Adapter Config
# Provider options: mock, openai, ollama
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434

# Vector Embeddings
# Provider options: mock, sentence-transformers, openai
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# External Threat Intelligence Adapters (Optional)
VT_API_KEY=
OTX_API_KEY=

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
