# Environment: development, test, production
# Demo seeding (simulate-scenario / seed-demo / seed-playbooks) is disabled when ENVIRONMENT=production
ENVIRONMENT=development
PROJECT_NAME="AI SOC Copilot"
API_V1_STR="/api/v1"

# Security & Authentication
SECRET_KEY=dev_secret_key_change_in_production_min_32_bytes_long_key_soc
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Settings
# For Docker Compose: postgresql+psycopg2://ai_soc_user:12410279@db:5432/ai_soc_db
# For Local Dev: sqlite:///./ai_soc_dev.db
DATABASE_URL=sqlite:///./ai_soc_dev.db
TEST_DATABASE_URL=sqlite:///./test_ai_soc.db

# LLM summaries (optional). mock = no provider used. Never put keys in source or the browser.
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
# Use a model alias your API key is entitled to (verify with GET /v1beta/models).
GEMINI_MODEL=gemini-3.5-flash
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434

# Vector embeddings: gemini requires GEMINI_API_KEY. mock is explicit offline/demo hash mode (not semantic search).
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=gemini-embedding-001

# Threat intelligence (optional). Empty keys produce unknown/not_configured, never fake "clean".
VT_API_KEY=
OTX_API_KEY=
TI_CACHE_TTL_MINUTES=60

# Authenticated webhook ingestion. source_id:token pairs. POST /api/v1/ingest/webhook/{source_id}
# Header: X-Ingest-Token: <token>  (or Authorization: Bearer <token>)
# Optional: X-Tenant-Id: tenant_default
INGEST_WEBHOOK_TOKENS=webhook-default:dev-ingest-token
# Demo seeding = explicit opt-in development feature (generates records labeled is_simulated=true).
# Leave false so the normal data path is real ingestion via the webhook. Forced off in production.
ENABLE_DEMO_SEEDING=false

# Correlation
CORRELATION_WINDOW_MINUTES=60
CORRELATION_MIN_ALERTS=2

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001"]
